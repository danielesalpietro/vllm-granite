# ── Template .env ──────────────────────────────────────────────────────────
# Copia questo file in ".env" (stesso nome, senza ".docker.example") e
# personalizza i valori per il tuo hardware. ".env" è ignorato da git
# (vedi .gitignore) — questo file invece è tracciato come esempio.

# ── vLLM ────────────────────────────────────────────────────────────────────
MODEL_ID=ibm-granite/granite-3.3-8b-instruct
HOST=0.0.0.0
PORT=8000
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.90
TENSOR_PARALLEL_SIZE=1
DTYPE=bfloat16

# Token Hugging Face, richiesto solo per modelli gated.
HF_TOKEN=

# GB di pesi da offloadare in RAM host (--cpu-offload-gb).
# Funziona SOLO su Docker Linux nativo. Su Docker Desktop/WSL2 qualsiasi
# valore > 0 fa crashare il container all'avvio (UVA/pin memory non
# supportata) — lascia 0 su WSL2, vedi README sezione "CPU offload".
CPU_OFFLOAD_GB=0

# Su Docker Desktop/WSL2, vLLM v0.25+ fallisce all'avvio con
# "RuntimeError: UVA is not available" anche con CPU_OFFLOAD_GB=0 — il
# nuovo "Model Runner V2" alloca un buffer pinned incondizionatamente, non
# solo per il CPU offload. Decommenta questa riga SOLO su WSL2 (torna al
# vecchio model runner, che non richiede UVA). Lasciare commentata su Linux
# nativo (es. la 3090): li' V2 funziona ed e' piu' efficiente.
# VLLM_USE_V2_MODEL_RUNNER=0

# Quantizzazione dei pesi on-the-fly. Vuoto (default) = bf16 pieno, invariato
# — usalo così su GPU da 24 GB (es. RTX 3090: i pesi dell'8B in bf16 ci stanno
# comodi, vedi README sezione "KV cache capacity").
# Su GPU più piccole (es. 16 GB, RTX 5080) dove i pesi bf16 (~15 GiB) non
# entrerebbero insieme alla KV cache, imposta:
#   QUANTIZATION=bitsandbytes
# (quantizza a 4-bit al volo, pesi ~4-5 GB invece di ~15, stesso MODEL_ID).
QUANTIZATION=

# ── AnythingLLM ───────────────────────────────────────────────────────────
# Password di login della UI. Cambiala prima di qualsiasi uso reale.
AUTH_TOKEN=changeme

# Richiesto da AnythingLLM per firmare le sessioni JWT.
# NON lasciare il valore di default in un ambiente esposto oltre
# localhost/rete fidata: genera un valore reale con:
#   openssl rand -hex 32
JWT_SECRET=changeme-generate-a-real-secret-with-openssl-rand--hex-32
